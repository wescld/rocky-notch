<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Hardened runtime blocks outgoing Apple Events without this. Rocky needs
	     them to jump to the right terminal tab (TerminalFocus drives Warp,
	     Terminal.app, iTerm and Ghostty through System Events). -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
</dict>
</plist>
